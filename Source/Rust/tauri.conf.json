{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panevanta",
  "version": "0.9.7",
  "identifier": "com.predskazatel.panevanta",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Panevanta", "create": false, "width": 980, "height": 815, "minWidth": 420, "minHeight": 520, "resizable": true, "decorations": false, "center": true }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
